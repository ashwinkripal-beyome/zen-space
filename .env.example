# Copy to .env for local Vite. Never commit real values.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# OpenAI is NOT configured here. Set OPENAI_API_KEY in Supabase → Edge Functions → Secrets
# and deploy: supabase functions deploy generate-zen-report
# See docs/OPENAI_EDGE_FUNCTION.md

# Razorpay — only the public key goes here (never the secret).
# Set RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET in
# Supabase → Edge Functions → Secrets. Optionally set PLAN_PRICE_18_WEEK_PAISE
# and PLAN_PRICE_ONE_ON_ONE_PAISE (amounts in paise; defaults: 99900 and 499900).
