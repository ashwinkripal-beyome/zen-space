# Copy to .env for local Vite. Never commit real values.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Feature flags. Temporarily disabled by default (WhatsApp OTP delivery is
# broken as of 2026-08-07). Set to true to re-enable the one-time WhatsApp
# phone verification gate for clients. Requires a rebuild to take effect.
VITE_WHATSAPP_OTP_ENABLED=false

# OpenAI is NOT configured here. Set OPENAI_API_KEY in Supabase → Edge Functions → Secrets
# and deploy: supabase functions deploy generate-zen-report
# See docs/OPENAI_EDGE_FUNCTION.md

# Razorpay — only the public key goes here (never the secret).
# Set RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET in
# Supabase → Edge Functions → Secrets.
#
# Package prices (amounts in paise) are resolved by the create-razorpay-order
# function from these secrets. Defaults (shown) are used if a secret is unset:
#   PLAN_PRICE_SEMI_GUIDED_3M_PAISE    = 749900   (Rs 7,499)
#   PLAN_PRICE_SEMI_GUIDED_6M_PAISE    = 1199900  (Rs 11,999)
#   PLAN_PRICE_SEMI_GUIDED_12M_PAISE   = 1999900  (Rs 19,999)
#   PLAN_PRICE_ONE_ON_ONE_3M_PAISE     = 899900   (Rs 8,999)
#   PLAN_PRICE_ONE_ON_ONE_6M_PAISE     = 1499900  (Rs 14,999)
#   PLAN_PRICE_ONE_ON_ONE_12M_PAISE    = 2399900  (Rs 23,999)
# The old PLAN_PRICE_18_WEEK_PAISE / PLAN_PRICE_ONE_ON_ONE_PAISE secrets are no
# longer read and can be deleted.

# WhatsApp OTP phone verification — NONE of these go in the frontend .env.
# Set them in Supabase → Edge Functions → Secrets (server-side only). See
# docs/WHATSAPP_OTP.md for the full dashboard setup.
#   WHATSAPP_ACCESS_TOKEN        Meta Graph API access token
#   WHATSAPP_PHONE_NUMBER_ID     WhatsApp Business phone number id
#   WHATSAPP_APP_SECRET          Meta App secret (used for appsecret_proof)
#   WHATSAPP_OTP_TEMPLATE_NAME   approved AUTHENTICATION template (default: otp_login)
#   WHATSAPP_OTP_TEMPLATE_LANG   template language code (default: en_US)
#   SEND_SMS_HOOK_SECRET         secret Supabase generates for the Send SMS hook
